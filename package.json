{
  "name": "asteroid-miner-horizons",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "bundle-size": "node scripts/bundle-size.mjs",
    "bench": "tsx scripts/bench.ts",
    "bench:stress": "tsx --expose-gc scripts/bench.ts --stress",
    "balance": "tsx scripts/balance.ts",
    "balance:ci": "scripts/balance-ci.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
